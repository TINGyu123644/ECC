# commands.env.example — loop-orchestrator 工程命令模板
#
# 用法:
#   cp loop-orchestrator/templates/commands.env.example .ai/loop/commands.env
#   然后填实际命令 (按本项目测试/lint 工具填)
#
# 留空 = 跳过该层
# 所有命令以仓库根为 cwd
# 多模块用 && 串联

# ─── 必填 (verify 跑) ────────────────────────────────────────────────

# 格式化检查 (留空 = 跳过)
CMD_FMT=""

# Lint (例: npm run lint / ruff check / cargo clippy)
CMD_LINT=""

# 类型检查 / 编译 (例: tsc --noEmit / mypy / cargo check)
CMD_TYPECHECK=""

# 测试 (例: jest / pytest / cargo test / node tests/run-all.js)
CMD_TEST=""

# 项目自有门禁 (例: npm run release:approval-gate)
CMD_PROJECT_GATE=""

# ─── 可选 (loop-orchestrator 段 2 增强) ───────────────────────────────

# Size classifier (verify.sh 第 0 层)
# 默认指向 loop-orchestrator 内置 size-classify.js
CMD_SIZE_CLASSIFY="node loop-orchestrator/scripts/size-classify.js"

# Security gate (verify.sh 第 7 层; 仅当 diff 含 security trigger 触发)
# 默认指向 loop-orchestrator 内置 security-gate.js
CMD_SECURITY_GATE="node loop-orchestrator/scripts/security-gate.js"

# Capability rebuild (verify.sh 第 8 层; 7 天缓存失效重扫)
# 默认跑 loop-orchestrator 内置 capability-scanner.js
CMD_CAPABILITY_REBUILD="node loop-orchestrator/scripts/capability-scanner.js"

# ─── 单文件测试 (loop-orchestrator feature) ─────────────────────────────
# 占位符 %FILE% 替换为实际测试文件
CMD_TEST_FILE=""

# ─── 已知工作模板 (各栈 example) ─────────────────────────────────────

# Node + TypeScript:
# CMD_LINT="npm run lint"
# CMD_TYPECHECK="npx tsc --noEmit"
# CMD_TEST="node tests/run-all.js"
# CMD_PROJECT_GATE="npm run release:approval-gate"

# Python + pytest + ruff:
# CMD_LINT="ruff check ."
# CMD_TYPECHECK="mypy src/"
# CMD_TEST="pytest tests/ -v"
# CMD_PROJECT_GATE="python scripts/project-gate.py"

# Go:
# CMD_LINT="golangci-lint run"
# CMD_TYPECHECK="go vet ./..."
# CMD_TEST="go test ./..."
# CMD_PROJECT_GATE="bash scripts/release-gate.sh"

# Rust:
# CMD_LINT="cargo clippy"
# CMD_TYPECHECK="cargo check"
# CMD_TEST="cargo test"
# CMD_PROJECT_GATE="cargo build --release"
