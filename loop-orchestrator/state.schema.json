{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-orchestrator.local/state.schema.json",
  "title": "loop-orchestrator state.json",
  "description": "State machine state for loop-orchestrator. Forked from ai-coding-loop loop_state.py schema with two additions: ecc_review (orch-review output) and capabilities_cache_hash (capability cache invalidation marker).",
  "type": "object",
  "required": [
    "phase",
    "round",
    "max_rounds",
    "plan_attempts",
    "max_plan_attempts",
    "autonomous",
    "issues",
    "decisions",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "INIT",
        "CONTEXT",
        "REQUIREMENT",
        "PLAN",
        "CODE",
        "VERIFY",
        "REVIEW",
        "FIX",
        "DELIVER",
        "SAFE_STOP"
      ],
      "description": "Current state machine phase. 10 values from loop_state.py:21-22."
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "description": "Repair/iteration round counter. Incremented by state.py next-round on CONTINUE."
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum allowed rounds. Loop exits to DELIVER or SAFE_STOP when reached."
    },
    "plan_attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of PLAN phase re-entries. Capped at max_plan_attempts before force-exit to SAFE_STOP."
    },
    "max_plan_attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum allowed plan_attempts before SAFE_STOP. Default 2."
    },
    "autonomous": {
      "type": "boolean",
      "const": true,
      "description": "Always true. Reserved future-flag for hybrid mode."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round", "sig", "at"],
        "additionalProperties": false,
        "properties": {
          "round": { "type": "integer", "minimum": 0 },
          "sig": {
            "type": "string",
            "pattern": "^(test|gate|review):.+",
            "description": "Issue signature. Format: test:<file>::<case> | gate:<type>:<code|file> | review:<severity>:<summary>"
          },
          "detail": { "type": "string" },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "description": "Timestamp YYYY-MM-DD HH:MM:SS from loop_state.py:40"
          }
        }
      },
      "default": []
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "question", "chosen", "why", "reversible", "at"],
        "additionalProperties": false,
        "properties": {
          "phase": { "type": "string" },
          "question": { "type": "string" },
          "chosen": { "type": "string" },
          "why": { "type": "string" },
          "reversible": {
            "type": "string",
            "enum": ["yes", "no"]
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          }
        }
      },
      "default": []
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "baseline": {
      "type": "object",
      "description": "Initial test results baseline for delta accounting. Shape defined by caller (set-baseline --data JSON).",
      "additionalProperties": true,
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "ecc_size": {
      "type": "string",
      "enum": ["trivial", "small", "standard", "large"],
      "description": "loop-orchestrator extension: current task size tier from size-classify.js. Set by state.py set-size."
    },
    "ecc_review": {
      "type": "object",
      "description": "loop-orchestrator extension: orch-review.workflow.js output. Populated when REVIEW phase runs.",
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": ["APPROVE", "CHANGES_REQUESTED"]
        },
        "blocking": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "severity", "file"],
            "properties": {
              "title": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
              },
              "file": { "type": "string" },
              "line": { "type": ["integer", "null"] },
              "evidence": { "type": "string", "minLength": 1 },
              "proof": { "type": "string" },
              "fix": { "type": "string" }
            }
          }
        },
        "advisory": {
          "type": "array",
          "items": { "type": "object" }
        },
        "stats": {
          "type": "object",
          "properties": {
            "dimensions": { "type": "integer" },
            "failed": { "type": "integer" },
            "raw": { "type": "integer" },
            "unique": { "type": "integer" },
            "confirmed": { "type": "integer" },
            "unverified": { "type": "integer" },
            "refuted": { "type": "integer" }
          }
        },
        "ran_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
        }
      }
    },
    "capabilities_cache_hash": {
      "type": "string",
      "description": "loop-orchestrator extension: hash of loop-orchestrator/capabilities.json last-modified state. Used by capability-cache.js to detect drift (> 7 days stale).",
      "pattern": "^[a-f0-9]{32,}$"
    }
  }
}
