{
  "version": "1",
  "event": "PostToolUse",
  "description": "auto-lint hook，从 .claude/settings.json:5-12 拆出。Edit|Write|MultiEdit 后跑 lint。",
  "hooks": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "name": "auto-lint",
      "command": "bash -c 'source .ai/loop/commands.env 2>/dev/null; [ -n \"${CMD_LINT:-}\" ] && eval \"$CMD_LINT\" || true'"
    }
  ]
}
