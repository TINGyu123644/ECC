# .env.example — loop-orchestrator wrapper 根
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# 看 ECC-main/.env.example 拿全 ECC 本体变量 (ANTHROPIC_API_KEY / GITHUB_TOKEN / etc.)

# ─── loop-orchestrator ───────────────────────────────────────────────────────
# 显式指定 ECC submodule 根路径 (空时走 5 优先级探测)
# 留空 = 自动探测 wrapper 同级 ECC-main
LOOP_ORCH_ECC_ROOT=

# ─── Anthropic ────────────────────────────────────────────────────────────────
# 你的 Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# GitHub personal access token (MCP GitHub server 用)
GITHUB_TOKEN=

# ─── 其它 ─────────────────────────────────────────────────────────────────────
# 完整变量清单见 ECC-main/.env.example (ASTRAFLOW_API_KEY, ATLAS_API_KEY, etc.)
